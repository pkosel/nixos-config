#! /usr/bin/env nix-shell
#! nix-shell -i bash -p bash parted

set -euo pipefail

if (( EUID != 0 )); then
  echo "Run this helper as root from a NixOS live installer." >&2
  exit 1
fi

for required_command in lsblk findmnt parted mkfs.fat mkfs.ext4 mkswap mount mkdir swapon nixos-generate-config; do
  if ! command -v "$required_command" >/dev/null 2>&1; then
    echo "Required command not found in PATH: $required_command" >&2
    exit 1
  fi
done

read -p "Enter the name of the storage device to partition (e.g. /dev/nvme0n1): " -r
drive=$REPLY

if [[ ! $drive =~ ^/dev/(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)$ ]] || [[ -L $drive ]]; then
  echo "Use a canonical whole-disk path: /dev/sdX, /dev/vdX, /dev/xvdX, /dev/nvmeNnN or /dev/mmcblkN." >&2
  echo "Partitions, aliases and other storage backends are not supported." >&2
  exit 1
fi

if [[ ! -b $drive ]]; then
  echo "$drive is not a block device." >&2
  exit 1
fi

if ! disk_info=$(lsblk --all --nodeps --noheadings --raw --output KNAME,TYPE -- "$drive") ||
  [[ $disk_info != "${drive##*/} disk" ]]; then
  echo "$drive could not be verified as a canonical whole disk." >&2
  exit 1
fi

partition_prefix=$drive
if [[ $drive == *[0-9] ]]; then
  partition_prefix+=p
fi

if ! device_state=$(lsblk --all --list --noheadings --raw --output KNAME,TYPE,RO,MOUNTPOINTS -- "$drive") ||
  [[ -z $device_state ]]; then
  echo "Could not inspect the devices using $drive." >&2
  exit 1
fi

# Mapper partitions can report TYPE=part, so descendant names must also match.
while read -r device_name device_type read_only mountpoints; do
  if [[ $device_name != "${drive##*/}" && ! $device_name =~ ^${partition_prefix##*/}[0-9]+$ ]] ||
    [[ $device_type != disk && $device_type != part ]] ||
    [[ $read_only != 0 || -n $mountpoints ]]; then
    echo "$drive or a descendant is read-only, in use, or unsupported." >&2
    exit 1
  fi
done <<< "$device_state"

if [[ ! -d /mnt || -L /mnt ]]; then
  echo "/mnt must be an existing, non-symlink directory." >&2
  exit 1
fi

if ! mount_targets=$(findmnt --kernel --noheadings --raw --output TARGET) ||
  [[ -z $mount_targets ]]; then
  echo "Could not inspect existing mountpoints." >&2
  exit 1
fi

# Mounting the new root would hide existing mounts anywhere below /mnt.
while IFS= read -r mount_target; do
  if [[ $mount_target == /mnt || $mount_target == /mnt/* ]]; then
    echo "$mount_target is already mounted; /mnt and its descendants must be unused." >&2
    exit 1
  fi
done <<< "$mount_targets"

boot="${partition_prefix}1"
system="${partition_prefix}2"
swap="${partition_prefix}3"

echo
echo "The following layout will be created:"
echo "
$drive
   |
   ├── $boot (boot partition, fat32)
   |
   ├── $system (system partition, ext4)
   |
   └── $swap (swap partition, linux-swap)
"

echo
echo "WARNING! Continuing will cause $drive to be formatted."
read -p "Do you really want to continue? [y/N] " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  exit 1
fi

parted "$drive" -- mklabel gpt

parted "$drive" -- mkpart boot fat32 1MiB 512MiB
parted "$drive" -- set 1 esp on
mkfs.fat -F 32 -n boot "$boot"

parted "$drive" -- mkpart nixos ext4 512MiB -4GiB
mkfs.ext4 -L nixos "$system"

parted "$drive" -- mkpart swap linux-swap -4GiB 100%
mkswap -L swap "$swap"

mount "$system" /mnt

mkdir -p /mnt/boot
mount "$boot" /mnt/boot

swapon "$swap"

nixos-generate-config --root /mnt

echo
echo "Partitions have been created and hardware-configuration.nix has been generated."

