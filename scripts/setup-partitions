#! /usr/bin/env nix-shell
#! nix-shell -i bash -p bash parted

set -euo pipefail

read -p "Enter the name of the storage device to partition (e.g. /dev/nvme0n1): " -r
drive=$REPLY

if [[ ! -b $drive ]]; then
  echo "$drive is not a block device." >&2
  exit 1
fi

if [[ $drive =~ "nvme" ]]; then
  boot="${drive}p1"
  system="${drive}p2"
  swap="${drive}p3"
else
  boot="${drive}1"
  system="${drive}2"
  swap="${drive}3"
fi

echo
echo "The following layout will be created:"
echo "
$drive
   |
   ├── $boot (boot partition, fat32)
   |
   ├── $system (system partition, ext4)
   |
   └── $swap (swap partition, linux-swap)
"

echo
echo "WARNING! Continuing will cause $drive to be formatted."
read -p "Do you really want to continue? [y/N] " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  exit 1
fi

parted "$drive" -- mklabel gpt

parted "$drive" -- mkpart boot fat32 1MiB 512MiB
parted "$drive" -- set 1 esp on
mkfs.fat -F 32 -n boot "$boot"

parted "$drive" -- mkpart nixos ext4 512MiB -4GiB
mkfs.ext4 -L nixos "$system"

parted "$drive" -- mkpart swap linux-swap -4GiB 100%
mkswap -L swap "$swap"

mount /dev/disk/by-label/nixos /mnt

mkdir -p /mnt/boot
mount /dev/disk/by-label/boot /mnt/boot

swapon "$swap"

nixos-generate-config --root /mnt

echo
echo "Partitions have been created and hardware-configuration.nix has been generated."

